{
  "name": "bianqian",
  "version": "1.2.0",
  "description": "Windows Markdown 桌面便签",
  "main": "./out/main/index.js",
  "author": "ZY",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "node scripts/pack-win.mjs",
    "pack:icon": "node scripts/set-win-icon.mjs",
    "dist": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "electron-updater": "^6.8.9",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "com.zy.bianqian",
    "productName": "便签",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/**/*.7z",
      "!resources/**/*.zip"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/*.7z",
          "!**/*.zip"
        ]
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "便签",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MarkdownNote-Setup-${version}.${ext}"
    },
    "afterPack": "./scripts/electron-builder-hooks.cjs"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ZyPLJ",
      "repo": "MarkdownNote"
    }
  ]
}
